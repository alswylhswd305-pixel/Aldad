# الكلام الثابت بين «» — والمتغيرات بدونها

قل(«━━━━━━━━ مدير فلوسي ━━━━━━━━»)

اسأل(وش اسمك)
قل(«هلا والله» الاسم)

اسأل(كم راتبك)

المصاريف = []
أضف 150 إلى المصاريف
أضف 80 إلى المصاريف
أضف 45 إلى المصاريف
أضف 200 إلى المصاريف

قل(«━━ مصاريفك هالشهر ━━»)
لكل مبلغ في المصاريف قل المبلغ

احسب(مجموع المصاريف)
المجموع = الناتج
قل(«مجموع مصاريفك:» المجموع «دينار»)

قل(«أكبر مصروف:» أكبر المصاريف)
احسب(متوسط المصاريف)
قل(«متوسط المصروف:» الناتج «دينار»)

احسب(الراتب ناقص المجموع)
الباقي = الناتج
قل(«الباقي معك:» الباقي «دينار»)

احسب(20% من الراتب)
التوفير = الناتج
قل(«لازم توفر كل شهر:» التوفير «دينار»)

إذا(الباقي أكبر من التوفير)
    قل(«✓ ممتاز، تقدر توفر هالشهر»)
وإلا
    قل(«⚠ انتبه، مصاريفك عالية»)

احسب(التوفير ضرب 12)
قل(«توفيرك بالسنة:» الناتج «دينار»)

