# ابدأ هنا — لغة الضاد 1.9.17
# اضغط ▶ شغّل، وجاوب تحت لما يسألك

قل(هلا والله، هذي لغة الضاد)

اسأل(وش اسمك)
قل(هلا الاسم)

احسب(خمس بيضات وسعر البيضة دينارين)
قل(سعر البيض الناتج دينار)

اسأل(كم عمرك)
إذا(العمر أكبر من 18)
    قل(إنت بالغ)
وإلا
    قل(إنت صغير)

السلة = []
أضف تفاح إلى السلة
أضف موز إلى السلة
قول عدد السلة

كرر(قل الضاد لغتي 3 مرات)

ارسم(سفينة في البحر واسمها سعود)
