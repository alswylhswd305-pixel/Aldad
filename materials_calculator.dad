# ━━━━━━━━ حاسبة المواد — تشطيب غرفة ━━━━━━━━
# تحسب: مساحة الأرضية، عدد البلاط، مساحة الجدران، لترات الصبغ، والتكلفة

استورد رياضيات

قل(«━━━━━━━━ حاسبة المواد ━━━━━━━━»)
اسأل(كم طول الغرفة بالمتر واحفظ في الطول)
اسأل(كم عرض الغرفة بالمتر واحفظ في العرض)
اسأل(كم ارتفاع الجدار بالمتر واحفظ في الارتفاع)

# ── الأرضية
احسب(الطول ضرب العرض)
المساحة = الناتج
قل(«━━ الأرضية ━━»)
قل(«المساحة بالمتر المربع:»)
قل(المساحة)

# بلاط 60×60 = 0.36 متر مربع للحبة + 10% هدر
احسب(المساحة قسمة 0.36)
البلاط = رياضيات.سقف(الناتج ضرب 1.1)
قل(«عدد البلاط 60×60 مع 10% هدر:»)
قل(البلاط)

# ── الجدران
احسب(الطول زائد العرض)
المحيط = الناتج ضرب 2
احسب(المحيط ضرب الارتفاع)
الجدران = الناتج
قل(«━━ الجدران ━━»)
قل(«مساحة الجدران بالمتر المربع:»)
قل(الجدران)

# الصبغ: وجهين، واللتر يغطي 10 متر مربع
احسب(الجدران ضرب 2 قسمة 10)
الصبغ = رياضيات.سقف(الناتج)
قل(«لترات الصبغ (وجهين):»)
قل(الصبغ)

# ── التكلفة (عدّل الأسعار على كيفك)
سعر_البلاطة = 1.5
سعر_لتر_الصبغ = 2.25
احسب(البلاط ضرب سعر_البلاطة)
كلفة_البلاط = الناتج
احسب(الصبغ ضرب سعر_لتر_الصبغ)
كلفة_الصبغ = الناتج
احسب(كلفة_البلاط زائد كلفة_الصبغ)
المجموع = الناتج
قل(«━━ التكلفة ━━»)
قل(«البلاط بالدينار:»)
قل(كلفة_البلاط)
قل(«الصبغ بالدينار:»)
قل(كلفة_الصبغ)
قل(«المجموع بالدينار:»)
قل(المجموع)

إذا(المجموع أكبر من 500)
    قل(«⚠ التكلفة عالية — قارن الأسعار قبل الشراء»)
وإلا
    قل(«✓ التكلفة معقولة»)

احفظ(المجموع في تكلفة_الغرفة.txt)
ارسم(بيت وشجرة وشمس)
